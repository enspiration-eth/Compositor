{
  "name": "Photoshop.eth",
  "short_name": "Photoshop.eth",
  "description": "Photoshop.eth — the Photoshop alternative for Mac, running in your browser.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#242424",
  "theme_color": "#1e1e1e",
  "categories": ["photo", "graphics", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "image/*": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".tif", ".tiff", ".heic"], "application/octet-stream": [".psd", ".psb"] } }
  ]
}
